{% extends "base.twig" %}

{% block title %}Dashboard{% endblock %}

{% block main %}    
    <section class="row dashboard"> 
        <h2 class="text-center">Dashboard Panel</h2>
        <div class="dashboard-options">
            <section >
                <h3 class="text-align-center">Search options</h3>
                <h4>Users</h4>
                <ul>
                    <li><a href="/admin/search/searchByUserAndDate">Search by user and date</a></li>                    
                </ul>
                <h4>Projects</h4>
                <ul>
                    <li><a href="/admin/search/searchByProjectName">Search by project name</a></li>
                    <li><a href="/admin/search/searchByActiveProjects">Search by active Projects</a></li>                    
                </ul>
