                    <li><a href="/Tasks/task/index">Tasks Index</a></li>
                    <li><a href="/Tasks/task/new">New Task</a></li>
                </ul>
            </section>
            <section>
                <h3 class="text-align-center">Projects options</h3>
                <ul>
                    <li><a href="/projects/project/index">Projects Index</a></li> 
                    <li><a href="/projects/project/new">New Project</a></li>                  
                </ul>
            </section>
        </div>                      
