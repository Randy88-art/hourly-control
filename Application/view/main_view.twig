{% extends "base.twig" %}

{% block section %}
    {# Shows working space if logged #}
    {% if session.user_name is defined %}
    <form id="hours_control_form" action="#" method="post">
        <input type="hidden" name="csrf_token" value="{% if csrf_token is defined %}{{ csrf_token.csrf_token }}{% endif %}">
        <section class="row mb-5">
            <h2 class="text-align-center mb-4">Select project and task</h2>
            <div class="text-align-center">
                <!-- Project -->
                <select class="col-2 text-align-center" name="project" id="project">
                    {% if fields.project is defined and fields.project != null %}
                        <option value="{{ fields.project.getProjectId() }}">{{ fields.project.getProjectName() }}</option>
                    {% else %}
                        <option value="0">- Select Project -</option>
                    {% endif %}
                    {% set current_project = current_project_task is defined ? current_project_task['project_name'] : null %}
                    {% if projects is defined %}
                        {% for project in projects %}
                            {% if project.active %}
                                {% set selected = '' %}
                                {% if current_project is not null and project.project_name == current_project %}
                                    {% set selected = 'selected' %}
                                {% endif %}
                                <option value="{{ project.project_id }}" {{ selected }}>{{ project.project_name }}</option>
                            {% endif %}                                                    
                        {% endfor %}                        
                    {% endif %}
                </select>

                <!-- Task -->
                <select class="col-2 text-align-center" name="task" id="task">
                    {% if fields.task is defined and fields.task != null %}
                        <option value="{{ fields.task.getTaskId() }}">{{ fields.task.getTaskName() }}</option>
                    {% else %}
                        <option value="0">- Select Task -</option>
                    {% endif %}
                    {% set current_task = current_project_task is defined ? current_project_task['task_name'] : null %}
                    {% if tasks is defined %}
                        {% for task in tasks %}
                            {% if task.active %}
                                {% set selected = '' %}
                                {% if current_task is not null and task.task_name == current_task %}
                                    {% set selected = 'selected' %}
                                {% endif %}
                                <option value="{{ task.task_id }}" {{ selected }}>{{ task.task_name }}</option>
                            {% endif %}                            
                        {% endfor %}
                    {% endif %}
                </select>
            </div>        
        </section>
        <section class="row text-align-center mb-5">    
            <h2>Work time information</h2>
            <div class="col col-md-8 col-lg-6 m-auto">
                <table class="table table-bordered table-striped m-auto table-dark">
                    <thead>
                        <tr>
                            <th>Work state</th>
                            <th>Start time</th>
                            <th>Exit time</th>
                            <th>Duration</th>
                            <th>Total worked today</th>
                        </tr>
                    </thead>
                    <tbody>                   
                        <tr>
                            <td>
                                <div class="col alert alert-{{ workstate_color }} mb-0">
                                    {{ workstate }}
                                </div>
                            </td>
                            <td>{{ hours.date_in }}</td>
                            <td>{{ hours.date_out }}</td>
                            <td>{{ hours.duration }}</td>
                            <td>{{ hours.total_time }}</td>
                        </tr>                    
                    </tbody>
                </table>
            </div>                   
        </section>
        <section class="row text-align-center">
            <h2>Hours Control</h2>
            <div>
                <button id="enter" class="col-3 col-md-2 btn btn-outline-success">Enter</button>
                <button id="exit" class="col-3 col-md-2 btn btn-outline-danger">Exit</button>                
            </div> 
        </section>
    </form>
    {% else %}
    {# Shows main view for not logged users #}
    <section class="row text-align-center">
        <h2>Hours Control</h2>
        <figure id="clock">
            <img src="/images/hourlycontrol.png" alt="clock">
        </figure>
        <div><h3>Test the time you spend in your taks</h3></div>
        <div>
            <a href="/login" class="col col-md-2 btn btn-outline-primary">Login</a>
        </div>
    </section>
    {% endif %}
{% endblock section %}
